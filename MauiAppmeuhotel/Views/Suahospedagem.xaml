<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppmeuhotel.Views.Suahospedagem"
             Title="Suahospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F1EA">
    <VerticalStackLayout VerticalOptions="Center"
                         Padding="10"
                         Spacing="10">

        <Label Text="Cálculo da Diária"
               FontFamily="PassionOneRegular"
               FontSize="50"
               TextColor="#243B53" />

        <Border Padding="10"
        Margin="10"
        Background="White"
        Stroke="#D3D3D3"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 10">

            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor= "#243B53"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor= "#243B53"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                </Grid>


                <Border Padding="10"
               Background="White"
               Stroke="#D3D3D3"
               StrokeThickness="1"
               StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>

                        <Label Text="Escolha sua Suíte"
                               TextTransform="Uppercase"
                               FontSize="18"
                               TextColor= "#243B53"/>

                        <Picker x:Name="pck_quarto"
                                Title="Selecione sua Acomodação" 
                                ItemDisplayBinding="{Binding Descricao}"/>
                    </VerticalStackLayout>

                    <Border.Shadow>

                        <Shadow Brush="Black"
                        Offset="0,3"
                        Radius="8"
                       Opacity="0.20"/>
                    </Border.Shadow>

                </Border>

                <Border Padding="10"
                      Margin="10"
                      Background="White"
                      Stroke="#D3D3D3"
                      StrokeThickness="1"
                       StrokeShape="RoundRectangle 10">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Período da Estadia"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor= "#243B53"/>

                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="Check-in:" />
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="Check-out:" />
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="10"
                            Margin="10"
                           Background="White"
                           Stroke="#D3D3D3"
                           StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">

                    <VerticalStackLayout>

                        <Button Text="Sobre"
                                BackgroundColor="#243B53"
                                TextColor="White"
                                Clicked="Btn_sobre_clicked"/>

                        <Button Text="Próximo"
                               Margin="0,10" 
                               BackgroundColor="#243B53"
                               TextColor="White"
                               Clicked="Btn_proximo_clicked"/>
                        
                        <Button Text="Nossos quartos"
                               BackgroundColor="#243B53"
                               TextColor="White"
                               Clicked="Btn_nossoshoteis_clicked"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>